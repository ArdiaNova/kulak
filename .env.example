# PayPal sandbox (browser: developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Filled after the webhook is created in the PayPal dashboard (needs a public URL)
PAYPAL_WEBHOOK_ID=
# true in production. false only for local testing.
PAYPAL_WEBHOOK_VERIFY=true
# Sandbox Personal account that receives every supplier payout
SUPPLIER_PAYOUT_EMAIL=sb-xxxx@personal.example.com

# Supabase (server-side only; never expose the service-role key to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM: any OpenAI-compatible endpoint that supports tool calling
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
